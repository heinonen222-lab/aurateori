{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://svmacmiwmzxowywfrjja.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "aurateori",
      "version": "0.1.0",
      "title": "Aurateori"
    },
    "tools": [
      {
        "name": "search_road_signs",
        "title": "Sök vägmärken",
        "description": "Search Aurateori's Swedish road sign library by free text and/or category. Returns name, meaning and the common exam trap for each match.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free text matched against name and meaning.",
              "type": "string"
            },
            "category": {
              "description": "Restrict to one sign category.",
              "type": "string",
              "enum": [
                "Varningsmärken",
                "Förbudsmärken",
                "Påbudsmärken",
                "Anvisningsmärken",
                "Information"
              ]
            },
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_theory_questions",
        "title": "Sök teorifrågor",
        "description": "Search Aurateori's Swedish B-licence theory question bank by free text and/or category. Returns question, options, correct answer, explanation and official source.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free text matched against question text.",
              "type": "string"
            },
            "category": {
              "type": "string",
              "enum": [
                "Vägmärken",
                "Trafikregler",
                "Miljö",
                "Människan & Trafiken",
                "Fordonskännedom"
              ]
            },
            "limit": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_lessons",
        "title": "Genomgångar",
        "description": "List Aurateori's interactive Swedish theory lessons, or fetch one lesson in full (steps, check questions and official Trafikverket/Transportstyrelsen sources).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "lessonId": {
              "description": "Lesson id; omit to list all lessons.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_premium_status",
        "title": "Premiumstatus",
        "description": "Read the signed-in Aurateori user's subscription status: plan, state and current period end.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
